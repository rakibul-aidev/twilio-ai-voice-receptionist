# ── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890   # Your Twilio number

# ── Anthropic Claude ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Server ───────────────────────────────────────────────────
PORT=3000
BASE_URL=https://your-ngrok-or-server-url.com   # Must be HTTPS for Twilio webhooks

# ── Business Config ──────────────────────────────────────────
BUSINESS_NAME="Sunrise Dental Clinic"
BUSINESS_PHONE=+1234567890
BUSINESS_HOURS="Monday to Friday, 9am to 5pm"
TIMEZONE=America/New_York

# ── Post-call webhook (n8n / Make / Zapier) ──────────────────
# Receives call summary JSON after each call ends
POST_CALL_WEBHOOK_URL=https://your-n8n-instance.com/webhook/call-summary

# ── Optional: Google Calendar for appointment booking ────────
# Leave blank to disable calendar integration
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json
